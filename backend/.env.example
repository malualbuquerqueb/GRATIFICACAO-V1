# Copie para .env. Sem POSTGRES_DB o backend usa SQLite (desenvolvimento).
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=1

# 1 = o front informa o perfil no cabeçalho X-Perfil (seletor de perfil do protótipo).
# Desligar quando o componente de Controle de Acesso tiver login de verdade.
SGGD_PERFIL_SIMULADO=1

